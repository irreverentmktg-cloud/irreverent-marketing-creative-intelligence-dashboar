# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Your Lovable account credentials
LOVABLE_EMAIL=you@example.com
LOVABLE_PASSWORD=your-password-here

# Full URL to your Lovable project editor
# Find it in your browser when the project is open, e.g.:
# https://lovable.dev/projects/abc123-def456-...
LOVABLE_PROJECT_URL=https://lovable.dev/projects/YOUR-PROJECT-ID

# Set to "false" to watch the browser run (useful for debugging)
HEADLESS=true
