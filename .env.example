# Arcads External API
# Get your key from: https://app.arcads.ai → Settings → API
ARCADS_API_KEY=

# Optional: override the default base URL
# ARCADS_BASE_URL=https://external-api.arcads.ai

# Optional: Playwright custom headers (for automated traffic identification)
# PW_HEADER_NAME=X-Automated-By
# PW_HEADER_VALUE=playwright-skill
# PW_EXTRA_HEADERS={"X-Automated-By":"playwright-skill"}
